{
  "name": "gitwe-vsce",
  "displayName": "gitwe » Git Workflow Engine",
  "description": "Run and visualize your gitwe branching workflow (start/finish/update/publish, topic-branch tree, health checks) right inside VS Code.",
  "version": "0.2.5",
  "publisher": "idmdakhi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/idmdakhi/gitwe-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "gitwe",
    "git-flow",
    "branching",
    "workflow"
  ],
  "activationEvents": [
    "workspaceContains:.gitwe/gitwe.yaml"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "configuration": {
      "title": "gitwe",
      "properties": {
        "gitwe.binaryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `gitwe` executable. Leave empty to use `gitwe` from `PATH`, falling back to `npx gitwe` if it isn't installed globally."
        },
        "gitwe.useNpxFallback": {
          "type": "boolean",
          "default": true,
          "description": "Fall back to `npx gitwe` when no `gitwe` binary is found on PATH."
        },
        "gitwe.confirmDestructiveActions": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before delete, force-finish, force-push and other destructive actions."
        },
        "gitwe.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the current topic branch in the status bar."
        },
        "gitwe.runInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Run mutating commands (start, finish, update, publish, ...) in an integrated terminal instead of capturing them silently. Read-only commands (list, current, overview, doctor, types) always run silently to feed the views."
        }
      }
    },
    "commands": [
      {
        "command": "gitwe.init",
        "title": "Init Workflow…",
        "category": "gitwe"
      },
      {
        "command": "gitwe.start",
        "title": "Start Branch…",
        "category": "gitwe",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "gitwe.finishCurrent",
        "title": "Finish Current Branch…",
        "category": "gitwe",
        "icon": "$(check)"
      },
      {
        "command": "gitwe.updateCurrent",
        "title": "Update Current Branch",
        "category": "gitwe",
        "icon": "$(sync)"
      },
      {
        "command": "gitwe.sync",
        "title": "Sync Current Branch",
        "category": "gitwe",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitwe.syncAll",
        "title": "Sync All Topic Branches",
        "category": "gitwe",
        "icon": "$(repo-sync)"
      },
      {
        "command": "gitwe.pull",
        "title": "Pull Current Branch",
        "category": "gitwe"
      },
      {
        "command": "gitwe.publishCurrent",
        "title": "Publish Current Branch",
        "category": "gitwe",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitwe.deleteCurrent",
        "title": "Delete Current Branch…",
        "category": "gitwe"
      },
      {
        "command": "gitwe.rename",
        "title": "Rename Current Branch…",
        "category": "gitwe"
      },
      {
        "command": "gitwe.checkout",
        "title": "Checkout Topic Branch…",
        "category": "gitwe"
      },
      {
        "command": "gitwe.track",
        "title": "Track Remote Branch…",
        "category": "gitwe"
      },
      {
        "command": "gitwe.tag",
        "title": "Create Tag…",
        "category": "gitwe"
      },
      {
        "command": "gitwe.rebase",
        "title": "Rebase Current Branch",
        "category": "gitwe"
      },
      {
        "command": "gitwe.abort",
        "title": "Abort In-Progress Finish",
        "category": "gitwe"
      },
      {
        "command": "gitwe.doctor",
        "title": "Run Doctor",
        "category": "gitwe",
        "icon": "$(pulse)"
      },
      {
        "command": "gitwe.doctorFix",
        "title": "Run Doctor --fix",
        "category": "gitwe"
      },
      {
        "command": "gitwe.validate",
        "title": "Validate Workflow Definition",
        "category": "gitwe"
      },
      {
        "command": "gitwe.graph",
        "title": "Show Branch Graph",
        "category": "gitwe"
      },
      {
        "command": "gitwe.log",
        "title": "Show Workflow Log",
        "category": "gitwe"
      },
      {
        "command": "gitwe.openDashboard",
        "title": "Open Dashboard",
        "category": "gitwe",
        "icon": "$(dashboard)"
      },
      {
        "command": "gitwe.refreshBranches",
        "title": "Refresh Branches",
        "category": "gitwe",
        "icon": "$(refresh)"
      },
      {
        "command": "gitwe.branch.finish",
        "title": "Finish…",
        "category": "gitwe",
        "icon": "$(check)"
      },
      {
        "command": "gitwe.branch.update",
        "title": "Update",
        "category": "gitwe",
        "icon": "$(sync)"
      },
      {
        "command": "gitwe.branch.checkout",
        "title": "Checkout",
        "category": "gitwe",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitwe.branch.publish",
        "title": "Publish",
        "category": "gitwe",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "gitwe.branch.rename",
        "title": "Rename…",
        "category": "gitwe"
      },
      {
        "command": "gitwe.branch.delete",
        "title": "Delete…",
        "category": "gitwe",
        "icon": "$(trash)"
      },
      {
        "command": "gitwe.baseBranch.checkout",
        "title": "Checkout",
        "category": "gitwe",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitwe.baseBranch.pull",
        "title": "Pull",
        "category": "gitwe",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitwe",
          "title": "gitwe",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "gitwe": [
        {
          "id": "gitwe.branches",
          "name": "Topic Branches",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "gitwe"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitwe.branches",
        "contents": "No gitwe workflow found in this workspace.\n[Initialize gitwe](command:gitwe.init)\nAlready have one? Make sure `.gitwe/gitwe.yaml` is at the repository root.",
        "when": "gitwe.hasWorkflow == false"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitwe.start",
          "when": "view == gitwe.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitwe.sync",
          "when": "view == gitwe.branches",
          "group": "navigation@2"
        },
        {
          "command": "gitwe.syncAll",
          "when": "view == gitwe.branches",
          "group": "navigation@3"
        },
        {
          "command": "gitwe.doctor",
          "when": "view == gitwe.branches",
          "group": "navigation@4"
        },
        {
          "command": "gitwe.openDashboard",
          "when": "view == gitwe.branches",
          "group": "navigation@5"
        },
        {
          "command": "gitwe.refreshBranches",
          "when": "view == gitwe.branches",
          "group": "navigation@6"
        },
        {
          "command": "gitwe.checkout",
          "when": "view == gitwe.branches",
          "group": "1_workflow@1"
        },
        {
          "command": "gitwe.track",
          "when": "view == gitwe.branches",
          "group": "1_workflow@2"
        },
        {
          "command": "gitwe.updateCurrent",
          "when": "view == gitwe.branches",
          "group": "1_workflow@3"
        },
        {
          "command": "gitwe.pull",
          "when": "view == gitwe.branches",
          "group": "1_workflow@4"
        },
        {
          "command": "gitwe.publishCurrent",
          "when": "view == gitwe.branches",
          "group": "1_workflow@5"
        },
        {
          "command": "gitwe.finishCurrent",
          "when": "view == gitwe.branches",
          "group": "1_workflow@6"
        },
        {
          "command": "gitwe.rename",
          "when": "view == gitwe.branches",
          "group": "1_workflow@7"
        },
        {
          "command": "gitwe.deleteCurrent",
          "when": "view == gitwe.branches",
          "group": "1_workflow@8"
        },
        {
          "command": "gitwe.doctorFix",
          "when": "view == gitwe.branches",
          "group": "2_maintenance@1"
        },
        {
          "command": "gitwe.validate",
          "when": "view == gitwe.branches",
          "group": "2_maintenance@2"
        },
        {
          "command": "gitwe.rebase",
          "when": "view == gitwe.branches",
          "group": "2_maintenance@3"
        },
        {
          "command": "gitwe.abort",
          "when": "view == gitwe.branches",
          "group": "2_maintenance@4"
        },
        {
          "command": "gitwe.tag",
          "when": "view == gitwe.branches",
          "group": "2_maintenance@5"
        },
        {
          "command": "gitwe.graph",
          "when": "view == gitwe.branches",
          "group": "3_insights@1"
        },
        {
          "command": "gitwe.log",
          "when": "view == gitwe.branches",
          "group": "3_insights@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gitwe.branch.checkout",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "inline@1"
        },
        {
          "command": "gitwe.branch.finish",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "inline@2"
        },
        {
          "command": "gitwe.branch.checkout",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "1_actions@1"
        },
        {
          "command": "gitwe.branch.update",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "1_actions@2"
        },
        {
          "command": "gitwe.branch.publish",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "1_actions@3"
        },
        {
          "command": "gitwe.branch.finish",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "1_actions@4"
        },
        {
          "command": "gitwe.branch.rename",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "2_danger@1"
        },
        {
          "command": "gitwe.branch.delete",
          "when": "view == gitwe.branches && viewItem == topicBranch",
          "group": "2_danger@2"
        },
        {
          "command": "gitwe.baseBranch.checkout",
          "when": "view == gitwe.branches && viewItem == baseBranch",
          "group": "inline@1"
        },
        {
          "command": "gitwe.baseBranch.pull",
          "when": "view == gitwe.branches && viewItem == baseBranch",
          "group": "inline@2"
        },
        {
          "command": "gitwe.baseBranch.checkout",
          "when": "view == gitwe.branches && viewItem == baseBranch",
          "group": "1_actions@1"
        },
        {
          "command": "gitwe.baseBranch.pull",
          "when": "view == gitwe.branches && viewItem == baseBranch",
          "group": "1_actions@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitwe.branch.finish",
          "when": "false"
        },
        {
          "command": "gitwe.branch.update",
          "when": "false"
        },
        {
          "command": "gitwe.branch.checkout",
          "when": "false"
        },
        {
          "command": "gitwe.branch.publish",
          "when": "false"
        },
        {
          "command": "gitwe.branch.rename",
          "when": "false"
        },
        {
          "command": "gitwe.branch.delete",
          "when": "false"
        },
        {
          "command": "gitwe.baseBranch.checkout",
          "when": "false"
        },
        {
          "command": "gitwe.baseBranch.pull",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run build",
    "build": "node esbuild.js --production",
    "clean": "rm -rf dist/ && rm -rf out/",
    "check-types": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
